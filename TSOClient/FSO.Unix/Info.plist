<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
        "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundleName</key>
        <string>OpenSO</string>
        <key>CFBundleDisplayName</key>
        <string>OpenSO</string>
        <key>CFBundleIdentifier</key>
        <string>org.openso.fso</string>
        <key>CFBundleVersion</key>
        <string>1.0</string>
        <key>CFBundleExecutable</key>
        <string>OpenSO</string>
        <key>NSHighResolutionCapable</key>
        <true/>
        <!-- Use the whole display, including the area beside/behind the camera housing, instead of the
             legacy compatibility mode that letterboxes content below it. Without this macOS lays
             fullscreen content out beneath the notch: the strip becomes a black bar, the window origin
             stops matching the content origin, and mouse coordinates end up offset by the notch height.
             The UI keeps clear of the notch itself via FSOEnvironment.SafeAreaTop. -->
        <key>NSPrefersDisplaySafeAreaCompatibilityMode</key>
        <false/>
        <key>LSApplicationCategoryType</key>
        <string>public.app-category.simulation-games</string>
        <key>LSMinimumSystemVersion</key>
        <string>13.0</string>
        <key>NSHumanReadableCopyright</key>
        <string><![CDATA[
Licensed under the Mozilla Public License, v. 2.0.
OpenSO is not in any way affiliated with Electronic Arts or The Sims, it is an unofficial community run project.]]></string>
    </dict>
</plist>
