<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
        "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundleName</key>
        <string>OpenSO</string>
        <key>CFBundleDisplayName</key>
        <string>OpenSO</string>
        <key>CFBundleIdentifier</key>
        <string>org.openso.fso</string>
        <key>CFBundleVersion</key>
        <string>1.0</string>
        <key>CFBundleExecutable</key>
        <string>OpenSO</string>
        <key>NSHighResolutionCapable</key>
        <true/>
        <!-- NOTE: NSPrefersDisplaySafeAreaCompatibilityMode=false was tried here to render under the
             camera housing, and macOS ignored it - the .NET apphost is not linked against an SDK new
             enough for the key to apply. Content stays laid out below the notch; the resulting mouse
             offset is corrected in FSOEnvironment.WindowTopOffset instead. Do not re-add without
             verifying on a notched Mac first. -->
        <key>LSApplicationCategoryType</key>
        <string>public.app-category.simulation-games</string>
        <key>LSMinimumSystemVersion</key>
        <string>13.0</string>
        <key>NSHumanReadableCopyright</key>
        <string><![CDATA[
Licensed under the Mozilla Public License, v. 2.0.
OpenSO is not in any way affiliated with Electronic Arts or The Sims, it is an unofficial community run project.]]></string>
    </dict>
</plist>
