<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
	  <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <ApplicationIcon>../FSO.Server/FreeSO.ico</ApplicationIcon>
    <IsAotCompatible>True</IsAotCompatible>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
	<SelfContained>False</SelfContained>
    <!-- Server GC: a long-running multi-lot game server is throughput-bound; the default workstation
         GC is tuned for desktop apps. DATAS (default with ServerGC on .NET 10) keeps heap growth
         adaptive on small deploy boxes. GC-only — no effect on SimAntics lockstep determinism. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- R2R removes JIT warmup spikes when the first lots spin up after a deploy. Needs a RID at
         publish time (CI and docker both pass one); per-push CI overrides this off for speed. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../FSO.Server/FreeSO.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="System.IO.FileSystem" Version="4.3.0" />
    <PackageReference Include="System.IO.FileSystem.Primitives" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSO.Content.TSO\FSO.Content.TSO.csproj" />
    <ProjectReference Include="..\FSO.Server.Api.Core\FSO.Server.Api.Core.csproj" />
    <ProjectReference Include="..\FSO.Server\FSO.Server.csproj" />
    <ProjectReference Include="..\tso.content\FSO.Content.csproj" />
  </ItemGroup>

</Project>
